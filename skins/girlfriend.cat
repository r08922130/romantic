# ------------------------------------------------------------------
#  girlfriend - brown hair with bangs, round glasses,
#  a white-and-blue striped shirt over a white top, jeans
#  (a person: same file format as the cats, see README-skins.md)
# ------------------------------------------------------------------
name: girlfriend
size: 11 11
#         skin    hair    glasses  eyes   mouth   top     shirt   jeans  shoes
palette:  F=223   H=130   G=244b   A=231b M=211   W=255b  B=153   J=67   K=95
eyes:     normal=o  wide=O  happy=^  closed=-  wink=^-
# a hat sits on her hair
hat:      4 1

@head
|
|   {H}_____
|  {H}/'''''\
| {H}|{G}({A}%L{G})-({A}%R{G}){H}|
| {H}|{F}\$${M}o$${F}/{H}|

@pose stand
@layer 0 5
|  {B}/|\{W}v{B}/|\
| {B}/ |{W}:::{B}| \
| {F}' {B}|{W}:::{B}| {F}'
|   {B}'---'
@layer 0 9 walk
|    {J}| |
|   {K}-' '-
---
|   {J}/  |
|  {K}-'  '-
@layer 0 0 head

@pose sit
@layer 0 5
|  {B}/|\{W}v{B}/|\
| {B}/ |{W}:::{B}| \
| {F}' {B}|{W}:::{B}| {F}'
|   {B}'---'
@layer 0 9
|    {J}| |
|   {K}-' '-
@layer 0 0 head

@pose peace
@layer 0 2
|          {F}V
|          {F}|
|         {B}/
|  {B}/|\{W}v{B}/|/
| {B}/ |{W}:::{B}|
| {F}' {B}|{W}:::{B}|
|   {B}'---'
@layer 0 9
|    {J}| |
|   {K}-' '-
@layer 0 0 head
