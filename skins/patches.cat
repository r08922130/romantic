---
|
| {T}.
|{O}(_~{S}~{O}~{S}~{O}~{S}~{O}~{S}~{O}~-
@layer 9 6
|   {O}/           \
|  {O}/             \
| {O}(~{S}~{O}~{W}:::::::::{O}~{S}~{O}~)
| {O}(~{S}~{O}~{W}:::::::::{O}~{S}~{O}~)
|  {O}\~{S}~{O}~{W}:::::::{O}~{S}~{O}~/
|  {O}`-({W}u u{O})---({W}u u{O})-'
@layer 9 0 head

@pose crouch
@layer 0 2 tail
|  {T},
| {T}( )
|  {S}\ \
|   {O}\ \
|    {O}\ \
---
|    {T},
|   {T}( )
|   {S}/ /
|  {O}/ /
| {O}/ /
@layer 5 7
