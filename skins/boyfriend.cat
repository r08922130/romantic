# ------------------------------------------------------------------
#  boyfriend - short dark hair, round glasses, a light-blue T-shirt,
#  a black crossbody bag and black shorts
#  (a person: same file format as the cats, see README-skins.md)
# ------------------------------------------------------------------
name: boyfriend
size: 11 11
#         skin    hair    glasses  eyes   mouth   t-shirt bag     shorts shoes
palette:  F=223   H=242   G=244b   A=231b M=174   T=110   L=239   N=238  K=250
eyes:     normal=o  wide=O  happy=^  closed=-  wink=^-
hat:      4 1

@head
|
|   {H}.^^^.
|  {H}(^^^^^)
| {F}|{G}({A}%L{G})-({A}%R{G}){F}|
|  {F}\$${M}u$${F}/

@pose stand
@layer 0 5
|  {T}/|{L}\$${T}|\
| {T}/ |${L}\${T}|$\
| {F}' {T}|$${L}[#] {F}'
|   {N}|_|_|
@layer 0 9 walk
|    {F}| |
|   {K}-' '-
---
|   {F}/  |
|  {K}-'  '-
@layer 0 0 head

@pose sit
@layer 0 5
|  {T}/|{L}\$${T}|\
| {T}/ |${L}\${T}|$\
| {F}' {T}|$${L}[#] {F}'
|   {N}|_|_|
@layer 0 9
|    {F}| |
|   {K}-' '-
@layer 0 0 head

@pose peace
@layer 0 2
|          {F}V
|          {F}|
|         {T}/
|  {T}/|{L}\$${T}|/
| {T}/ |${L}\${T}|
| {F}' {T}|$${L}[#]
|   {N}|_|_|
@layer 0 9
|    {F}| |
|   {K}-' '-
@layer 0 0 head
