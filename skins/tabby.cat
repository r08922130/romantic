# ------------------------------------------------------------------
#  tabby - the round, calm one (photo 2): striped orange tabby,
#  white blaze & muzzle, pink nose, amber eyes, white chest and paws
#  (see README-skins.md for how this file works)
# ------------------------------------------------------------------
name: tabby
size: 22 6
#         fur    stripes  white   nose    eyes    whiskers
palette:  O=208  S=130    W=255b  P=218   A=214b  K=245
eyes:     normal=o  wide=O  happy=^  closed=-  wink=^-
# where a scene's accessory sits: a hat's brim starts at column 3, row 1
hat:      3 1

@head
|
| {O}/\___/\
|{O}({S}={A}%L{W}${P}.{W}${A}%R{S}={O})
| {O}${K}>{W}${P}w{W}${K}<{O}$

# ---------------- standing / walking ----------------
@pose stand
@layer 0 1 tail
|{O} ,
|{S}(
|{O} \
---
|{O},
|{S} )
|{O} /
@layer 0 2
|   {O}.-{S}={O}~{S}={O}~{S}={O}-.
|  {O}/{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~
| {O}({S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{W}:::::{O})
@layer 0 5 walk
|  {O}`-{W}uu{O}----------{W}uu{O}-'
---
|  {O}`---{W}uu{O}------{W}uu{O}---'
@layer 12 0 head

# ---------------- sitting ----------------
@pose sit
@layer 0 4 tail
|{O} ,
|{S}({O}~{S}~{O}~-
---
|{O}.
|{O}~{S}~{O}~{S}~{O}-
@layer 6 3
|{O}/         \
@layer 4 4
|{O}({S}={O}~{S}={O}~{W}:::::{O}~{S}={O}~{S}={O})
@layer 5 5
|{O}`-{W}uu{O}-----{W}uu{O}-'
@layer 7 0 head

# ---------------- curled up asleep ----------------
@pose sleep
@layer 2 4
|{O}.-{S}={O}~{S}={O}~{S}={O}~-.
@layer 1 5
|{O}({S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={W}uu
@layer 12 2 head

# run / crouch / peek are not drawn -> they fall back automatically

# ================== bigger sizes (@scale) ==================
# The same cat drawn bigger, used when the window is big enough
# (see README-skins.md). Same palette and eyes as above.

@scale 2
size:     44 12
hat:      5 2

@head
|
|
|   {O}/\___________/\
|  {O}/$${S}={O}~{S}=$$$$$={O}~{S}=$${O}\
| {O}({S}=$$$${A}%L$$$$$%R$$$${S}={O})
|  {O}\{S}=$$$$$${P}v$$$$$${S}={O}/
| {K}>{S}==$$$$$${W}w$$$$$${S}=={K}<
|    {O}`-.._________..-'

@pose stand
@layer 0 2 tail
|  {O}_
| {S}( )
|  {O}\ \
|   {O}\ \
|    {O}\ \
---
|    {O}_
|   {S}( )
|   {O}/ /
|  {O}/ /
| {O}/ /
