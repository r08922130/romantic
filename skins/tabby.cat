|  {O}({S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{W}::::::::{O})
|   {O}\{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{W}::::::::{O}/
@layer 4 11 walk
|    {O}`-.({W}uu{O}).-----------.({W}uu{O}).-'
---
|    {O}`---.({W}uu{O}).-------.({W}uu{O}).---'
@layer 23 0 head

@pose sit
@layer 0 9 tail
|  {O}_
| {O}( \{S}={O}~{S}={O}~{S}={O}~-
|
---
|
| {O}.
|{O}(_{S}={O}~{S}={O}~{S}={O}~{S}={O}~-
@layer 11 6
|   {O}/               \
|  {O}/{S}={O}~{S}=           ={O}~{S}={O}\
| {O}({S}={O}~{S}={O}~{S}={O}~{W}:::::::::{O}~{S}={O}~{S}={O})
| {O}({S}={O}~{S}={O}~{S}={O}~{W}:::::::::{O}~{S}={O}~{S}={O})
|  {O}\{S}={O}~{S}={O}~{S}={O}~{W}:::::::{O}~{S}={O}~{S}={O}/
|  {O}`-.({W}uu{O})-------({W}uu{O}).-'
@layer 13 0 head

@pose sleep
@layer 3 7
|      {O}.-{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}-.
|    {O}.'{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~
|   {O}({S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}=
|  {O}({S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~({W}uu{O})
|   {O}`-.{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}~{S}={O}-'
@layer 23 4 head

@scale 1.5
size:     33 9
hat:      4 1

@head
